module top_module #(
	parameter bitswideth = 8
)( 
    input [bitswideth - 1:0] in,
    output [7:0] out
);

genvar i;

generate
	for(i = 0;i < 8;i = i + 1) begin : reverse_loop
		assign out[i] = in[bitswideth - 1 - i];
	end
endgenerate

endmodule

